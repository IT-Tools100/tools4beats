# Project Verse — переменные окружения.
# Скопируйте в .env и при необходимости измените.
# Секреты (токены, пароли) здесь НЕ хранятся — только в macOS Keychain.

APP_ENV=development
APP_NAME=Project Verse

# PostgreSQL (см. docker-compose.yml, порт 5433)
DATABASE_URL=postgresql+psycopg://verse:verse@127.0.0.1:5433/verse
TEST_DATABASE_URL=postgresql+psycopg://verse:verse@127.0.0.1:5433/verse_test

# Куда складывать экспорты, резервные копии и логи.
DATA_DIR=~/Library/Application Support/ProjectVerse

LOG_LEVEL=INFO
